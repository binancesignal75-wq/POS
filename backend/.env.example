PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=typos_pos

# JWT secret (min 32 characters)
JWT_SECRET=change-this-to-a-secure-random-secret-key-32chars

# Super Admin login PIN (/#/admin)
ADMIN_PIN=123456

# Public and Frontend URLs
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# CORS allowed origins (comma separated or *)
CORS_ORIGIN=*

# Store login token expiration days
TOKEN_DAYS=30

# Local timezone offset (Pakistan = +05:00)
TZ_OFFSET=+05:00

# Groq API key for medicine AI scanner
GROQ_API_KEY=
